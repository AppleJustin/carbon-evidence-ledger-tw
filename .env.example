DATA_DIR=data

# Optional. Public CFP_P_02 data is downloaded from data.gov.tw resource URLs
# parsed from https://data.gov.tw/dataset/28176. MOENV_API_KEY is only an
# optional fallback to the MOENV Open Data API. Never commit a real key.
#   export MOENV_API_KEY="your-key"
# then:
#   PYTHONPATH=src python -m carbon_ledger references fetch
MOENV_API_KEY=
